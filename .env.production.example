# Variables de build para Producción. Copiar a .env.production (ignorado por git) y completar antes de
# `npm run build`. En el build (modo production) estos valores tienen prioridad sobre .env; `npm run dev` sigue
# usando .env. Los valores quedan incrustados en el HTML publicado: aquí no va ningún secreto.

# URL del servicio consent-api en Cloud Run, https y sin barra final. Se obtiene con:
#   gcloud run services describe consent-api --region=<REGION> --format="value(status.url)"
PUBLIC_API_BASE_URL=https://<URL_DE_CLOUD_RUN>

# URL de la política de privacidad (PENDIENTE-14). Respaldo: la landing usa primero la que devuelve la API.
# Debe ser la misma que PRIVACY_POLICY_URL del backend, que es la que se guarda en la evidencia.
PUBLIC_PRIVACY_POLICY_URL=https://<URL_POLITICA_DE_PRIVACIDAD>
