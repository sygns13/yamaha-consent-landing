---
import BaseLayout from "../layouts/BaseLayout.astro";

// Agradecimiento (M6): diseño y texto propuestos por el responsable. Se llega aquí con ACEPTADO y con NO_ACEPTADO.
// Sin botones ni enlaces a otras acciones: el cliente solo cierra la ventana.
---

<BaseLayout title="¡Gracias! | Yamaha">
  <section class="flex flex-col items-center py-10 text-center sm:rounded-xl sm:bg-white sm:p-10 sm:shadow-sm">
    <div class="flex size-16 items-center justify-center rounded-full bg-brand/10">
      <svg
        aria-hidden="true"
        class="size-9 text-brand"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12.5l4.5 4.5L19 7.5"></path>
      </svg>
    </div>
    <h1 class="mt-6 text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">¡Gracias por tu respuesta!</h1>
    <p class="mt-3 max-w-sm leading-relaxed text-slate-600">
      Hemos registrado tus autorizaciones correctamente. Ya puedes cerrar esta ventana.
    </p>
  </section>
</BaseLayout>
