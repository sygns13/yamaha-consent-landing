---
import BaseLayout from "../layouts/BaseLayout.astro";

// Enlace inválido (M6): /enlace-invalido?motivo=vencido|usado|invalido. El título es fijo y debajo va el motivo.
// Con "invalido", un motivo desconocido o sin JavaScript queda solo el título, que ya es el mensaje por defecto.
// No se muestra ningún dato técnico (ni el motivo recibido ni códigos HTTP).
---

<BaseLayout title="Enlace no disponible | Yamaha">
  <section class="flex flex-col items-center py-10 text-center sm:rounded-xl sm:bg-white sm:p-10 sm:shadow-sm">
    <div class="flex size-16 items-center justify-center rounded-full bg-brand/10">
      <svg
        aria-hidden="true"
        class="size-9 text-brand"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 11v5.5M12 7.5h.01"></path>
      </svg>
    </div>
    <h1 class="mt-6 text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">Este enlace ya no está disponible</h1>
    <p data-motivo="vencido" hidden class="mt-3 max-w-sm leading-relaxed text-slate-600">El enlace ha vencido</p>
    <p data-motivo="usado" hidden class="mt-3 max-w-sm leading-relaxed text-slate-600">
      Ya registraste tus respuestas anteriormente
    </p>
  </section>
</BaseLayout>

<script>
  const KNOWN_REASONS = ["vencido", "usado"];

  const reason = new URLSearchParams(location.search).get("motivo");
  if (reason && KNOWN_REASONS.includes(reason)) {
    document.querySelector<HTMLElement>(`[data-motivo="${reason}"]`)!.hidden = false;
  }
</script>
