---
import Alert from "../components/Alert.astro";
import ConsentCheckbox from "../components/ConsentCheckbox.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
import PrivacyPolicyDialog from "../components/PrivacyPolicyDialog.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Landing de conformidad (M6): /?t={token}. Todo depende del token, así que la validación ocurre en el navegador.
---

<BaseLayout title="Autorización de datos | Yamaha">
  <section class="sm:rounded-xl sm:bg-white sm:p-8 sm:shadow-sm">
    <!-- Etiqueta y título siempre visibles: la página tiene su <h1> también mientras carga o si falla la carga. -->
    <p class="text-xs font-semibold uppercase tracking-wider text-brand">Autorización de datos</p>
    <h1 class="mt-2 text-3xl font-bold leading-tight text-slate-900">Tu privacidad es importante</h1>

    <!-- Región en vivo de los estados de carga: nunca se oculta; se muestra u oculta su contenido. -->
    <div role="status" aria-live="polite">
      <div id="loading" class="flex flex-col items-center gap-3 py-12 text-slate-600 noscript:hidden">
        <svg aria-hidden="true" class="size-8 text-brand motion-safe:animate-spin" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="3"></circle>
          <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
        </svg>
        <p>Cargando...</p>
      </div>
      <!-- El cambio de texto del botón no se anuncia: el script escribe aquí "Enviando..." mientras se envía. -->
      <p id="submit-status" class="sr-only"></p>
    </div>

    <noscript>
      <Alert class="mt-6">
        <p>Para continuar, activa JavaScript en tu navegador.</p>
      </Alert>
    </noscript>

    <Alert id="load-error" hidden class="mt-6">
      <p>No pudimos conectar. Revisa tu conexión e inténtalo de nuevo.</p>
      <button
        id="retry-button"
        type="button"
        class="rounded-sm font-semibold underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-danger"
      >
        Reintentar
      </button>
    </Alert>

    <div id="consent" hidden>
      <p class="mt-3 leading-relaxed text-slate-600">
        Antes de continuar, revisa la política de privacidad y selecciona las autorizaciones que deseas otorgar.
      </p>

      <hr class="my-6 border-slate-200" />

      <!--
        RN-01 (PENDIENTE-01 y PENDIENTE-17, sección 11): sin la nota "* Autorización obligatoria para continuar" ni
        asterisco en el check 1. Los checks nacen desmarcados y ENVIAR está siempre habilitado: se puede enviar con
        cualquier combinación, incluso con todo desmarcado.
      -->
      <form id="consent-form" novalidate>
        <fieldset id="consent-fields" class="space-y-6">
          <legend class="sr-only">Autorizaciones</legend>
          <ConsentCheckbox name="personal_data">Acepto la</ConsentCheckbox>
          <ConsentCheckbox name="marketing_yamaha" suffix=".">
            Autorizo a <strong>YAMAHA</strong> para el tratamiento de mis datos personales con fines de perfilamiento
            y envío de publicidad, de acuerdo con la
          </ConsentCheckbox>
          <ConsentCheckbox name="marketing_dealer" suffix=".">
            Autorizo al <strong data-dealer-name>DEALER</strong> para el tratamiento de mis datos personales con
            fines de perfilamiento y envío de publicidad, de acuerdo con la
          </ConsentCheckbox>
        </fieldset>

        <Alert id="submit-error" hidden class="mt-8">
          <p>No pudimos conectar. Revisa tu conexión e inténtalo de nuevo.</p>
        </Alert>

        <PrimaryButton id="submit-button" class="mt-8">ENVIAR</PrimaryButton>
      </form>
    </div>
  </section>

  <!-- Fuera de #consent: un <dialog> dentro de un contenedor oculto no se mostraría. -->
  <PrivacyPolicyDialog />
</BaseLayout>

<script>
  import { getConsentLink, submitConsent, type LinkUnavailable } from "../lib/api";

  const INVALID_LINK_REASONS: Record<LinkUnavailable["kind"], string> = {
    EXPIRED: "vencido",
    USED: "usado",
    NOT_FOUND: "invalido",
  };

  const loading = document.getElementById("loading")!;
  const loadError = document.getElementById("load-error")!;
  const retryButton = document.getElementById("retry-button")!;
  const consent = document.getElementById("consent")!;
  const form = document.getElementById("consent-form") as HTMLFormElement;
  const fields = document.getElementById("consent-fields") as HTMLFieldSetElement;
  const submitButton = document.getElementById("submit-button") as HTMLButtonElement;
  const submitError = document.getElementById("submit-error")!;
  const submitStatus = document.getElementById("submit-status")!;
  const privacyDialog = document.getElementById("privacy-dialog") as HTMLDialogElement;
  const privacyBody = document.getElementById("privacy-dialog-body")!;

  /** replace(): el botón Atrás no vuelve a esta página. */
  function goToInvalidLink(reason: string): void {
    location.replace(`/enlace-invalido?motivo=${reason}`);
  }

  function showForm(dealerName: string | null): void {
    // dealerName de KIZUNA; si no lo envió, queda el texto "DEALER" del HTML.
    if (dealerName) {
      for (const name of document.querySelectorAll("[data-dealer-name]")) name.textContent = dealerName;
    }
    loading.hidden = true;
    consent.hidden = false;
  }

  async function validateLink(token: string, isRetry: boolean): Promise<void> {
    loadError.hidden = true;
    loading.hidden = false;

    const result = await getConsentLink(token);
    switch (result.kind) {
      case "VALID":
        showForm(result.dealerName);
        return;
      case "NETWORK_ERROR":
        // El enlace puede estar bien: se queda en la página y permite reintentar.
        loading.hidden = true;
        loadError.hidden = false;
        if (isRetry) retryButton.focus();
        return;
      default:
        // El indicador de carga sigue visible hasta que cambia la página.
        goToInvalidLink(INVALID_LINK_REASONS[result.kind]);
    }
  }

  function isChecked(name: string): boolean {
    return (form.elements.namedItem(name) as HTMLInputElement).checked;
  }

  /** Bloquea el formulario mientras se envía: evita el doble clic y que se cambie un check ya enviado. */
  function setSubmitting(submitting: boolean): void {
    submitButton.disabled = submitting;
    // PrimaryButton muestra "Enviando..." con aria-busy="true".
    if (submitting) submitButton.setAttribute("aria-busy", "true");
    else submitButton.removeAttribute("aria-busy");
    fields.disabled = submitting;
    submitStatus.textContent = submitting ? "Enviando..." : "";
  }

  /** El token ya no sirve (respondido o vencido): se quita de la barra de direcciones. */
  function removeTokenFromUrl(): void {
    const url = new URL(location.href);
    url.searchParams.delete("t");
    history.replaceState(history.state, "", url);
  }

  async function submit(token: string): Promise<void> {
    // RN-01: sin validaciones ni confirmación. Cualquier combinación es válida, incluso todo desmarcado:
    // un check desmarcado es un rechazo y así se registra.
    submitError.hidden = true;
    setSubmitting(true);

    const result = await submitConsent(token, {
      personalDataConsent: isChecked("personal_data"),
      marketingConsentYMDP: isChecked("marketing_yamaha"),
      marketingConsentDEALER: isChecked("marketing_dealer"),
    });
    switch (result.kind) {
      case "SUBMITTED":
        // ACEPTADO o NO_ACEPTADO: en ambos casos se agradece.
        removeTokenFromUrl();
        location.replace("/gracias");
        return;
      case "NETWORK_ERROR":
        // El token se conserva en la URL: si el cliente recarga, la página vuelve a validar el enlace.
        setSubmitting(false);
        submitError.hidden = false;
        submitButton.focus();
        return;
      default:
        // 410 (vencido o usado) o 404. El botón sigue deshabilitado hasta que cambia la página.
        removeTokenFromUrl();
        goToInvalidLink(INVALID_LINK_REASONS[result.kind]);
    }
  }

  // Política de privacidad en un pop-up (spec v1.5): cada "política de privacidad" lo abre para su check. "Aceptar"
  // marca ese check; "Cancelar" y Escape (que cierra el <dialog> sin returnValue) lo desmarcan. El texto de la
  // política está en PrivacyPolicyDialog.astro (TODO(PENDIENTE-14)). La URL de la política que devuelve la API ya no
  // se usa aquí: el backend la sigue guardando en la evidencia.
  let privacyTrigger: HTMLButtonElement | null = null;

  function openPrivacyPolicy(trigger: HTMLButtonElement): void {
    privacyTrigger = trigger;
    privacyDialog.returnValue = "";
    privacyDialog.showModal();
    privacyBody.scrollTop = 0;
    privacyBody.focus();
  }

  privacyDialog.addEventListener("close", () => {
    if (!privacyTrigger) return;
    const checkbox = form.elements.namedItem(privacyTrigger.dataset.privacyTrigger ?? "") as HTMLInputElement | null;
    if (checkbox) checkbox.checked = privacyDialog.returnValue === "accept";
    privacyTrigger.focus();
    privacyTrigger = null;
  });
  document.getElementById("privacy-accept")!.addEventListener("click", () => privacyDialog.close("accept"));
  document.getElementById("privacy-cancel")!.addEventListener("click", () => privacyDialog.close("cancel"));
  for (const trigger of document.querySelectorAll<HTMLButtonElement>("[data-privacy-trigger]")) {
    // El botón está dentro del <label>: sin preventDefault, el clic también cambiaría el check.
    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      openPrivacyPolicy(trigger);
    });
  }

  const token = new URLSearchParams(location.search).get("t");
  if (!token) {
    goToInvalidLink(INVALID_LINK_REASONS.NOT_FOUND);
  } else {
    retryButton.addEventListener("click", () => void validateLink(token, true));
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!submitButton.disabled) void submit(token);
    });
    void validateLink(token, false);
  }
</script>
