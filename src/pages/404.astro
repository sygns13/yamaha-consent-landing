---
import BaseLayout from "../layouts/BaseLayout.astro";

// Página 404 (propuesta, fuera de la spec): astro build genera dist/404.html, que Firebase Hosting sirve con estado
// 404 para cualquier ruta que no exista. Sin ella, Firebase muestra su página genérica en inglés.
// Sin JavaScript ni datos técnicos (ni la ruta pedida), y sin botones: el sitio no tiene a dónde volver sin token.
---

<BaseLayout title="Página no encontrada | Yamaha">
  <section class="flex flex-col items-center py-10 text-center sm:rounded-xl sm:bg-white sm:p-10 sm:shadow-sm">
    <div class="flex size-16 items-center justify-center rounded-full bg-brand/10">
      <svg
        aria-hidden="true"
        class="size-9 text-brand"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.1M12 16.5h.01"></path>
      </svg>
    </div>
    <h1 class="mt-6 text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">Página no encontrada</h1>
    <p class="mt-3 max-w-sm leading-relaxed text-slate-600">
      La dirección que ingresaste no existe. Si llegaste desde el mensaje de WhatsApp, vuelve a abrir el enlace desde
      allí.
    </p>
  </section>
</BaseLayout>
