---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-surface text-slate-800 antialiased">
    <header class="flex items-center justify-between bg-white px-4 py-4 shadow-sm sm:px-8">
      <span class="text-xl font-extrabold tracking-wide text-brand">YAMAHA</span>
      <span class="flex items-center gap-1.5 text-xs text-slate-500 sm:text-sm">
        <svg aria-hidden="true" class="h-4 w-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" />
          <path d="M9 12l2 2 4-4" />
        </svg>
        Privacidad y consentimiento
      </span>
    </header>
    <main class="mx-auto w-full max-w-xl px-4 py-6 sm:py-10">
      <slot />
    </main>
  </body>
</html>
