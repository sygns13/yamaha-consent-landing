---
/**
 * Checkbox de la landing con su <label> y el botón "política de privacidad".
 *
 * El slot es el texto que va antes del botón y `suffix` lo que va después (p. ej. el punto final).
 * Los <strong> del slot se muestran en negrita y más oscuros, como "YAMAHA" y "DEALER" en el mockup.
 *
 * "política de privacidad" abre el pop-up de la política (PrivacyPolicyDialog, spec v1.5) en la misma página: su
 * [data-privacy-trigger] es el name del checkbox que marcan "Aceptar" y desmarcan "Cancelar" y Escape. El script de
 * index.astro lo maneja; el clic en el botón no cambia el check por sí solo.
 */
interface Props {
  /** Campo del body de submit (ConsentSubmitRequest). También es el id del checkbox. */
  name: "personal_data" | "marketing_yamaha" | "marketing_dealer";
  suffix?: string;
}

const { name, suffix = "" } = Astro.props;
---

<div class="flex items-start gap-3">
  <input
    id={name}
    name={name}
    type="checkbox"
    class="mt-0.75 size-5 shrink-0 cursor-pointer accent-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
  />
  <label
    for={name}
    class="cursor-pointer text-base leading-relaxed text-slate-600 [&_strong]:font-bold [&_strong]:text-slate-900"
  >
    <slot />{" "}<button
      type="button"
      data-privacy-trigger={name}
      aria-haspopup="dialog"
      class="cursor-pointer rounded-sm text-left text-brand underline underline-offset-2 hover:text-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand disabled:cursor-default"
      >política de privacidad</button
    >{suffix}
  </label>
</div>
